<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#171a21"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gaming DNA"
                android:textColor="#66c0f4"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/akatab" />

            <TextView
                android:id="@+id/dnaSubtitle_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Based on your most played titles"
                android:textColor="#adadad"
                android:textSize="12sp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/genreText_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="1. Action\n2. RPG\n3. Indie"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/akatab" />

        </LinearLayout>

        <TextView
            android:id="@+id/clearFiltersBtn_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:text="CLEAR FILTERS"
            android:textColor="#66c0f4"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp" />

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>